          "type": "transcript_range",
          "startMilliseconds": 180590,
          "endMilliseconds": 194000
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#storing-an-address"
      }
    },
    {
      "id": "TP-018",
      "startMilliseconds": 201480,
      "endMilliseconds": 220150,
      "kind": "reason",
      "text": "The type for the address variable cannot be int because the cell holds a number carrying the extra requirements of being an address of a four-cell int block, so it is declared with the asterisk form.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 201480,
          "endMilliseconds": 220150
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#declaring-an-int-pointer"
