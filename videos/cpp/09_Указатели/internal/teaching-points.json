    },
    {
      "id": "TP-010",
      "startMilliseconds": 118310,
      "endMilliseconds": 127380,
      "kind": "fact",
      "text": "A pointer and a plain int differ only in how the program interprets the stored number, since both cells ultimately hold numbers.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 118310,
          "endMilliseconds": 127380
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#storing-an-address"
      }
    },
    {
      "id": "TP-011",
      "startMilliseconds": 127400,
      "endMilliseconds": 135390,
      "kind": "reason",
      "text": "Memory cells can only hold numbers, which is why a pointer cannot literally store a memory location and must store the address as a number.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 127400,
          "endMilliseconds": 135390
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#storing-an-address"
      }
    },
    {
      "id": "TP-012",
      "startMilliseconds": 135390,
      "endMilliseconds": 142550,
      "kind": "explanation",
      "text": "The number stored in the pointer is always interpreted by the program as an address of some other cell.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 135390,
          "endMilliseconds": 142550
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#storing-an-address"
      }
    },
    {
      "id": "TP-013",
      "startMilliseconds": 142550,
      "endMilliseconds": 150550,
      "kind": "explanation",
      "text": "The address a pointer carries must be the address of a cell holding an integer, i.e. the address of an int, so the target is found correctly.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 142550,
          "endMilliseconds": 150550
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#storing-an-address"
