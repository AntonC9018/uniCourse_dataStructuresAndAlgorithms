    },
    {
      "id": "TP-019",
      "startMilliseconds": 224270,
      "endMilliseconds": 243550,
      "kind": "fact",
      "text": "The asterisk type represents the address of the beginning of an int, i.e. the start of the four-cell block, hiding all of that structure behind one type name.",
