    },
    {
      "id": "TP-014",
      "startMilliseconds": 150550,
      "endMilliseconds": 165239,
      "kind": "fact",
      "text": "Because the target variable has type int, what is actually stored in the pointer cell is the address of an int variable.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 150550,
          "endMilliseconds": 165239
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#storing-an-address"
      }
    },
    {
      "id": "TP-015",
      "startMilliseconds": 165239,
      "endMilliseconds": 172680,
      "kind": "explanation",
      "text": "The pointer holds only the starting position, so the program must additionally remember which other cells belong to the same value before it can read it back.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 165239,
          "endMilliseconds": 172680
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#storing-an-address"
      }
    },
    {
      "id": "TP-016",
      "startMilliseconds": 172680,
      "endMilliseconds": 180590,
      "kind": "reason",
      "text": "An int occupies four memory cells that must be read together and interpreted as one whole number, so the program must track all four cells behind the stored address.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 172680,
          "endMilliseconds": 180590
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#storing-an-address"
      }
    },
    {
      "id": "TP-017",
      "startMilliseconds": 180590,
      "endMilliseconds": 194000,
      "kind": "explanation",
      "text": "The stored value 32 is therefore not just a number but the start address leading to four memory cells that the program must read as a unit.",
      "evidence": [
