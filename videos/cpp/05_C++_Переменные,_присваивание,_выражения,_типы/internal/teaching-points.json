      }
    },
    {
      "id": "TP-045",
      "startMilliseconds": 441759,
      "endMilliseconds": 448400,
      "kind": "correction",
      "text": "The value must additionally be converted to int before printing, otherwise printing produces zero despite the assigned value.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 441759,
          "endMilliseconds": 448400
        },
