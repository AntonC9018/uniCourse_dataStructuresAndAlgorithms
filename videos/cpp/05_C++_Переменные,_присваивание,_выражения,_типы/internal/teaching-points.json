        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#an-out-of-range-assignment"
      }
    },
    {
      "id": "TP-044",
      "startMilliseconds": 424000,
      "endMilliseconds": 436720,
      "kind": "explanation",
      "text": "The variable name behaves as an expression inside the print call, so something can even be added to it before printing.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 424000,
          "endMilliseconds": 436720
        },
        {
          "type": "video_frame",
          "frame": "inspection-68571c832e5971f53a14ea95-d73399ec24420ec8a12df83c-1b4502788e4bd1ea.png"
        }
      ],
      "englishCoverage": {
        "status": "covered",
