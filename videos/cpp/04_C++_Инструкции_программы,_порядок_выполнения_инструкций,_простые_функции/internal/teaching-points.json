    {
      "id": "TP-033",
      "startMilliseconds": 356710,
      "endMilliseconds": 372070,
      "kind": "reason",
      "text": "When no instructions remain in the function's list, the processor jumps back to the place where the function was last called and continues with the next instruction after that call.",
